---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { createExcerpt, estimateReadingTime, formatBlogDate, sortBlogPosts } from "../../lib/blog";

export async function getStaticPaths() {
    const blogEntries = sortBlogPosts(await getCollection("blog"));

    return blogEntries.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prevPost: index > 0 ? blogEntries[index - 1] : null,
            nextPost: index < blogEntries.length - 1 ? blogEntries[index + 1] : null,
            morePosts: blogEntries.filter((post) => post.id !== entry.id).slice(0, 3),
        },
    }));
}

interface Props {
    entry: CollectionEntry<"blog">;
    prevPost: CollectionEntry<"blog"> | null;
    nextPost: CollectionEntry<"blog"> | null;
    morePosts: CollectionEntry<"blog">[];
}

const { entry, prevPost, nextPost, morePosts } = Astro.props;
const { Content } = await render(entry);
const readingTime = estimateReadingTime(entry.body || "");
const description =
    createExcerpt(entry.body || "", 240) || entry.data.shortTitle || entry.data.title;
---

<Layout title={entry.data.title} description={description} showProgress={true}>
    <div class="mx-auto max-w-3xl animate-fade-up">

        <!-- ── Breadcrumb nav ──────────────────────────────────────────── -->
        <nav class="mb-10 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
            <a href="/" class="btn-ghost py-2 px-3.5 text-sm">← Archive</a>
            <a href="/discover" class="btn-ghost py-2 px-3.5 text-sm">Discover</a>
        </nav>

        <!-- ── Article header ─────────────────────────────────────────── -->
        <header class="space-y-5 mb-10">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono tracking-wide" style="color:rgba(129,140,248,0.7);">
                <time datetime={entry.data.date?.toISOString()}>
                    {formatBlogDate(entry.data.date)}
                </time>
                <span aria-hidden="true" style="color:rgba(255,255,255,0.2);">·</span>
                <span>{readingTime} min read</span>
            </div>

            <h1 class="text-[clamp(2rem,5vw,3.75rem)] font-extrabold leading-[1.06] tracking-tight text-balance">
                {entry.data.title}
            </h1>

            {
                entry.data.shortTitle && (
                    <p class="text-lg sm:text-xl leading-relaxed text-pretty" style="color:rgba(255,255,255,0.5);">
                        {entry.data.shortTitle}
                    </p>
                )
            }

            {
                entry.data.image && (
                    <div class="mt-8 overflow-hidden rounded-2xl" style="border:1px solid rgba(255,255,255,0.08);box-shadow:0 24px 60px -12px rgba(0,0,0,0.7);">
                        <img
                            src={entry.data.image}
                            alt={entry.data.title}
                            class="w-full h-auto object-cover"
                            loading="eager"
                        />
                    </div>
                )
            }
        </header>

        <!-- ── Article body ───────────────────────────────────────────── -->
        <article class="prose prose-invert prose-lg max-w-none">
            <Content />
        </article>

        <!-- ── Divider ────────────────────────────────────────────────── -->
        <hr class="divider my-14" />

        <!-- ── Prev / Next nav ────────────────────────────────────────── -->
        <nav class="grid gap-4 sm:grid-cols-2" aria-label="Article navigation">
            {
                prevPost ? (
                    <a
                        href={`/blog/${prevPost.id}`}
                        class="glass-card p-5 group"
                    >
                        <p class="text-xs font-semibold tracking-[0.22em] uppercase mb-2" style="color:rgba(255,255,255,0.3);">← Previous</p>
                        <h3 class="text-sm font-bold leading-snug line-clamp-2 group-hover:text-indigo-200 transition-colors">
                            {prevPost.data.shortTitle || prevPost.data.title}
                        </h3>
                    </a>
                ) : (
                    <div class="glass-card p-5 opacity-35">
                        <p class="text-xs font-semibold tracking-[0.22em] uppercase mb-2" style="color:rgba(255,255,255,0.3);">← Previous</p>
                        <p class="text-sm" style="color:rgba(255,255,255,0.35);">First post in the archive.</p>
                    </div>
                )
            }

            {
                nextPost ? (
                    <a
                        href={`/blog/${nextPost.id}`}
                        class="glass-card p-5 sm:text-right group"
                    >
                        <p class="text-xs font-semibold tracking-[0.22em] uppercase mb-2" style="color:rgba(255,255,255,0.3);">Next →</p>
                        <h3 class="text-sm font-bold leading-snug line-clamp-2 group-hover:text-indigo-200 transition-colors">
                            {nextPost.data.shortTitle || nextPost.data.title}
                        </h3>
                    </a>
                ) : (
                    <div class="glass-card p-5 sm:text-right opacity-35">
                        <p class="text-xs font-semibold tracking-[0.22em] uppercase mb-2" style="color:rgba(255,255,255,0.3);">Next →</p>
                        <p class="text-sm" style="color:rgba(255,255,255,0.35);">You've reached the latest post.</p>
                    </div>
                )
            }
        </nav>

        <!-- ── More posts ─────────────────────────────────────────────── -->
        {
            morePosts.length > 0 && (
                <section class="mt-14">
                    <div class="mb-6 flex items-center justify-between gap-4">
                        <div>
                            <p class="text-xs font-semibold tracking-[0.22em] uppercase mb-1" style="color:rgba(129,140,248,0.6);">More to explore</p>
                            <h2 class="text-xl font-extrabold">Keep diving in</h2>
                        </div>
                        <a href="/discover" class="btn-ghost text-sm py-2 px-3.5 hidden sm:inline-flex">Open discover →</a>
                    </div>

                    <div class="grid gap-4 stagger" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));">
                        {morePosts.map((post) => (
                            <a
                                href={`/blog/${post.id}`}
                                class="glass-card p-5 group flex flex-col gap-3"
                            >
                                <p class="text-xs font-mono" style="color:rgba(129,140,248,0.65);">{formatBlogDate(post.data.date)}</p>
                                <h3 class="text-sm font-bold leading-snug line-clamp-3 group-hover:text-indigo-200 transition-colors">
                                    {post.data.shortTitle || post.data.title}
                                </h3>
                                <p class="text-xs leading-relaxed line-clamp-3 mt-auto" style="color:rgba(255,255,255,0.38);">
                                    {createExcerpt(post.body || "", 100)}
                                </p>
                            </a>
                        ))}
                    </div>

                    <div class="mt-6 sm:hidden">
                        <a href="/discover" class="btn-ghost w-full text-center py-3">Open discover →</a>
                    </div>
                </section>
            )
        }
    </div>
</Layout>
