---
import Layout from "../../layouts/Layout.astro";
import {
    getCloudPost,
    getCloudPosts,
    renderCloudMarkdown,
    type CloudPost,
} from "../../lib/cloud-blog";
import { createExcerpt, estimateReadingTime, formatBlogDate } from "../../lib/blog";

export const prerender = false;

interface Props {
    entry: CloudPost;
    prevPost: CloudPost | null;
    nextPost: CloudPost | null;
    morePosts: CloudPost[];
}

const slug = Astro.params.slug;
const blogEntries = await getCloudPosts();
const entry = slug ? await getCloudPost(slug) : null;
if (!entry) return Astro.redirect("/");
const index = blogEntries.findIndex((post) => post.id === entry.id);
const prevPost = index > 0 ? blogEntries[index - 1] : null;
const nextPost = index >= 0 && index < blogEntries.length - 1 ? blogEntries[index + 1] : null;
const morePosts = blogEntries.filter((post) => post.id !== entry.id).slice(0, 3);
const contentHtml = await renderCloudMarkdown(entry.body);
const readingTime = estimateReadingTime(entry.body || "", entry.data.wordCount);
const description =
    createExcerpt(entry.body || "", 240) || entry.data.shortTitle || entry.data.title;
---

<Layout
    title={entry.data.title}
    description={description}
    showProgress={true}
    sidebarPosts={blogEntries}
    currentPost={entry}
>
    <div class="mx-auto animate-fade-up">
        <!-- ── Breadcrumb nav ──────────────────────────────────────────── -->
        <nav class="mb-10 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
            <a href="/" class="btn-ghost py-2 px-3.5 text-sm">← Archive</a>
            <a href="/discover" class="btn-ghost py-2 px-3.5 text-sm">Discover</a>
        </nav>

        <!-- ── Article header ─────────────────────────────────────────── -->
        <header class="article-header">
            {
                entry.data.image ? (
                    <div class="article-cover relative isolate aspect-video overflow-hidden rounded-xl border border-(--color-border) bg-(--color-surface-soft) shadow-(--shadow-glow-lg)">
                        <img
                            src={entry.data.image}
                            alt=""
                            class="absolute inset-0 size-full object-cover"
                            loading="eager"
                        />
                        <div
                            aria-hidden="true"
                            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"
                        />
                        <div class="absolute inset-x-0 bottom-0 z-10 grid gap-2 p-4 sm:gap-3 sm:p-7">
                            <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-white/85 sm:text-sm">
                                <time datetime={entry.data.date?.toISOString()}>
                                    {formatBlogDate(entry.data.date)}
                                </time>
                                <span>{readingTime} min read</span>
                            </div>
                            <h1 class="m-0 max-w-5xl font-(family-name:--font-display) text-2xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
                                {entry.data.title}
                            </h1>
                        </div>
                    </div>
                ) : (
                    <>
                        <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-(--color-accent-2) sm:text-sm">
                            <time datetime={entry.data.date?.toISOString()}>
                                {formatBlogDate(entry.data.date)}
                            </time>
                            <span>{readingTime} min read</span>
                        </div>
                        <h1 class="article-title">{entry.data.title}</h1>
                    </>
                )
            }

            {entry.data.shortTitle && <p class="article-deck">{entry.data.shortTitle}</p>}
        </header>

        <!-- ── Article body ───────────────────────────────────────────── -->
        <article class="prose prose-lg article-prose max-w-none">
            <Fragment set:html={contentHtml} />
        </article>

        <!-- ── Divider ────────────────────────────────────────────────── -->
        <hr class="my-14 border-0 border-t border-(--color-border)" />

        <!-- ── Prev / Next nav ────────────────────────────────────────── -->
        <nav class="grid gap-4 sm:grid-cols-2" aria-label="Article navigation">
            {
                prevPost ? (
                    <a
                        href={`/blog/${prevPost.id}`}
                        class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                    >
                        <p class="mb-2 text-xs font-semibold text-(--color-muted)">
                            Previous article
                        </p>
                        <h3 class="text-sm font-bold leading-snug line-clamp-2 transition-colors group-hover:text-(--color-accent-1) hover:text-(--color-accent-1)">
                            {prevPost.data.shortTitle || prevPost.data.title}
                        </h3>
                    </a>
                ) : (
                    <div class="rounded-xl border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-card) opacity-35">
                        <p class="mb-2 text-xs font-semibold text-(--color-muted)">
                            Previous article
                        </p>
                        <p class="text-sm" style="color:var(--color-text-soft);">
                            First post in the archive.
                        </p>
                    </div>
                )
            }

            {
                nextPost ? (
                    <a
                        href={`/blog/${nextPost.id}`}
                        class="group rounded-xl border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover) sm:text-right"
                    >
                        <p class="mb-2 text-xs font-semibold text-(--color-muted)">Next article</p>
                        <h3 class="text-sm font-bold leading-snug line-clamp-2 transition-colors group-hover:text-(--color-accent-1) hover:text-(--color-accent-1)">
                            {nextPost.data.shortTitle || nextPost.data.title}
                        </h3>
                    </a>
                ) : (
                    <div class="rounded-xl border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-card) opacity-35 sm:text-right">
                        <p class="mb-2 text-xs font-semibold text-(--color-muted)">Next article</p>
                        <p class="text-sm" style="color:var(--color-text-soft);">
                            You've reached the latest post.
                        </p>
                    </div>
                )
            }
        </nav>

        <!-- ── More posts ─────────────────────────────────────────────── -->
        {
            morePosts.length > 0 && (
                <section class="mt-14">
                    <div class="mb-6 flex items-center justify-between gap-4">
                        <div>
                            <p class="mb-2 text-xs font-semibold text-(--color-muted)">
                                More to explore
                            </p>
                            <h2 class="text-xl font-extrabold">Keep diving in</h2>
                        </div>
                        <a
                            href="/discover"
                            class="btn-ghost text-sm py-2 px-3.5 hidden sm:inline-flex"
                        >
                            Open discover →
                        </a>
                    </div>

                    <div
                        class="grid gap-4 stagger"
                        style="grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));"
                    >
                        {morePosts.map((post) => (
                            <a
                                href={`/blog/${post.id}`}
                                class="group flex flex-col gap-3 rounded-xl border border-(--color-border) bg-(--color-surface) p-4 shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                            >
                                <p class="text-xs font-mono" style="color:var(--color-accent-1);">
                                    {formatBlogDate(post.data.date)}
                                </p>
                                <h3 class="text-sm font-bold leading-snug line-clamp-3 transition-colors group-hover:text-(--color-accent-1) hover:text-(--color-accent-1)">
                                    {post.data.shortTitle || post.data.title}
                                </h3>
                                <p
                                    class="text-xs leading-relaxed line-clamp-3 mt-auto"
                                    style="color:var(--color-text-soft);"
                                >
                                    {createExcerpt(post.body || "", 100)}
                                </p>
                            </a>
                        ))}
                    </div>

                    <div class="mt-6 sm:hidden">
                        <a href="/discover" class="btn-ghost w-full text-center py-3">
                            Open discover →
                        </a>
                    </div>
                </section>
            )
        }
    </div>
</Layout>
