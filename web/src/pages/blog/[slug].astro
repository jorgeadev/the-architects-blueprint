---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
    createExcerpt,
    estimateReadingTime,
    formatBlogDate,
    sortBlogPosts,
} from "../../lib/blog";

export async function getStaticPaths() {
    const blogEntries = sortBlogPosts(await getCollection("blog"));

    return blogEntries.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            prevPost: index > 0 ? blogEntries[index - 1] : null,
            nextPost: index < blogEntries.length - 1 ? blogEntries[index + 1] : null,
            morePosts: blogEntries.filter((post) => post.id !== entry.id).slice(0, 3),
        },
    }));
}

interface Props {
    entry: CollectionEntry<"blog">;
    prevPost: CollectionEntry<"blog"> | null;
    nextPost: CollectionEntry<"blog"> | null;
    morePosts: CollectionEntry<"blog">[];
}

const { entry, prevPost, nextPost, morePosts } = Astro.props;
const { Content } = await render(entry);
const readingTime = estimateReadingTime(entry.body);
const description = createExcerpt(entry.body, 240) || entry.data.shortTitle || entry.data.title;
---

<Layout title={entry.data.title} description={description}>
    <div class="mx-auto max-w-4xl">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
            <a
                href="/discover"
                class="px-4 py-2 rounded-lg font-sans font-semibold text-sm transition-all duration-300 bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/30"
            >
                ← Back to discover
            </a>
            <a
                href="/"
                class="px-4 py-2 rounded-lg font-sans font-semibold text-sm transition-all duration-300 bg-linear-to-br from-indigo-500/20 to-blue-500/20 text-indigo-200 border border-indigo-400/20 hover:border-indigo-300/50 hover:text-white"
            >
                Archive home
            </a>
        </div>

        <header class="space-y-5">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono uppercase tracking-[0.28em] text-indigo-300/80">
                <span>{formatBlogDate(entry.data.date)}</span>
                <span>•</span>
                <span>{readingTime} min read</span>
            </div>
            <h1 class="text-[clamp(2.4rem,5vw,4.75rem)] font-bold leading-[0.95]">
                {entry.data.title}
            </h1>
            {entry.data.shortTitle && (
                <p class="max-w-3xl text-lg text-zinc-300">
                    {entry.data.shortTitle}
                </p>
            )}
            {entry.data.image && (
                <div class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
                    <img
                        src={entry.data.image}
                        alt={entry.data.title}
                        class="h-auto w-full object-cover"
                    />
                </div>
            )}
        </header>

        <article
            class="prose prose-invert prose-lg mx-auto mt-10 max-w-3xl prose-h1:text-center prose-h1:text-[clamp(1.75rem,3.5vw,2.75rem)] prose-h1:leading-tight prose-h1:bg-linear-to-r prose-h1:from-indigo-400 prose-h1:to-blue-400 prose-h1:bg-clip-text prose-h1:text-transparent prose-pre:bg-slate-900 prose-pre:border-white/10 prose-pre:border prose-code:text-indigo-300"
        >
            <Content />
        </article>

        <section class="mt-14 grid gap-4 md:grid-cols-2">
            {prevPost ? (
                <a
                    href={`/blog/${prevPost.id}`}
                    class="glass-card p-5 transition-all duration-300 hover:border-indigo-400/30"
                >
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Previous article</div>
                    <h2 class="mt-2 text-lg font-bold leading-snug">{prevPost.data.shortTitle || prevPost.data.title}</h2>
                    <p class="mt-3 text-sm text-zinc-400 line-clamp-2">
                        {createExcerpt(prevPost.body, 140)}
                    </p>
                </a>
            ) : (
                <div class="glass-card p-5 opacity-60">
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Previous article</div>
                    <p class="mt-3 text-sm text-zinc-400">This is the first post in the archive.</p>
                </div>
            )}

            {nextPost ? (
                <a
                    href={`/blog/${nextPost.id}`}
                    class="glass-card p-5 text-right transition-all duration-300 hover:border-indigo-400/30"
                >
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Next article</div>
                    <h2 class="mt-2 text-lg font-bold leading-snug">{nextPost.data.shortTitle || nextPost.data.title}</h2>
                    <p class="mt-3 text-sm text-zinc-400 line-clamp-2">
                        {createExcerpt(nextPost.body, 140)}
                    </p>
                </a>
            ) : (
                <div class="glass-card p-5 text-right opacity-60">
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Next article</div>
                    <p class="mt-3 text-sm text-zinc-400">You’ve reached the latest post.</p>
                </div>
            )}
        </section>

        <section class="mt-14">
            <div class="mb-5 flex items-end justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.32em] text-zinc-500">More to explore</p>
                    <h2 class="mt-2 text-2xl font-bold">Keep diving into the archive</h2>
                </div>
                <a
                    href="/discover"
                    class="hidden rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-200 transition-all duration-300 hover:border-indigo-400/40 hover:bg-white/10 hover:text-white sm:inline-flex"
                >
                    Open discover
                </a>
            </div>

            <div class="grid gap-5 grid-cols-[repeat(auto-fill,minmax(240px,1fr))]">
                {morePosts.map((post) => (
                    <a
                        href={`/blog/${post.id}`}
                        class="glass-card p-5 transition-all duration-300 hover:border-indigo-400/30"
                    >
                        <div class="text-xs font-mono text-indigo-300/80">
                            {formatBlogDate(post.data.date)}
                        </div>
                        <h3 class="mt-3 text-lg font-bold leading-snug line-clamp-3">
                            {post.data.shortTitle || post.data.title}
                        </h3>
                        <p class="mt-3 text-sm text-zinc-400 line-clamp-3">
                            {createExcerpt(post.body, 120)}
                        </p>
                    </a>
                ))}
            </div>
        </section>
    </div>
</Layout>
