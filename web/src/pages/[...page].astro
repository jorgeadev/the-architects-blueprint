---
import Layout from "../layouts/Layout.astro";
import { getCloudPosts, type CloudPost } from "../lib/cloud-blog";
import { createExcerpt, estimateReadingTime, formatBlogDate } from "../lib/blog";

export const prerender = false;

interface Props {
    page: {
        data: CloudPost[];
        currentPage: number;
        lastPage: number;
        url: { prev?: string; next?: string };
    };
}

const allPosts = await getCloudPosts();
const firstPageSize = 7;
const laterPageSize = 9;
const currentPage = Math.max(1, Number(Astro.params.page ?? "1") || 1);
const lastPage =
    allPosts.length <= firstPageSize
        ? 1
        : 1 + Math.ceil((allPosts.length - firstPageSize) / laterPageSize);
const pageOffset = currentPage === 1 ? 0 : firstPageSize + (currentPage - 2) * laterPageSize;
const currentPageSize = currentPage === 1 ? firstPageSize : laterPageSize;
const page: Props["page"] = {
    data: allPosts.slice(pageOffset, pageOffset + currentPageSize),
    currentPage,
    lastPage,
    url: {
        prev: currentPage > 2 ? `/${currentPage - 1}` : currentPage === 2 ? "/" : undefined,
        next: currentPage < lastPage ? `/${currentPage + 1}` : undefined,
    },
};
const nearbyPages = [
    ...new Set([1, page.currentPage - 1, page.currentPage, page.currentPage + 1, page.lastPage]),
]
    .filter((pageNumber) => pageNumber >= 1 && pageNumber <= page.lastPage)
    .sort((left, right) => left - right);
const paginationItems: Array<number | "ellipsis"> = [];
nearbyPages.forEach((pageNumber, index) => {
    if (index > 0 && pageNumber - nearbyPages[index - 1] > 1) {
        paginationItems.push("ellipsis");
    }
    paginationItems.push(pageNumber);
});
const isFirstPage = page.currentPage === 1;
const featuredPost = isFirstPage ? page.data[0] : null;
const gridPosts = isFirstPage ? page.data.slice(1) : page.data;
---

<Layout title="The Architect's Blueprint | Engineering Blog" sidebarPosts={allPosts}>
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    {
        isFirstPage && (
            <section class="pt-3 pb-4 sm:pt-4 sm:pb-4 animate-fade-up">
                <p class="mb-2 flex items-center gap-2 text-sm font-semibold text-(--color-accent-2)">
                    <span class="size-2 rounded-full bg-(--color-accent-2)" aria-hidden="true" />{" "}
                    Engineering journal
                </p>
                <div class="max-w-3xl">
                    <h1 class="home-title">
                        Architecting <br />
                        the Future.
                    </h1>
                    <p
                        class="mt-2 text-lg sm:text-xl leading-relaxed max-w-2xl"
                        style="color:var(--color-text-soft);"
                    >
                        Deep dives into big‑tech infrastructure, distributed systems, and the pulse
                        of modern engineering — generated, curated, and served fresh.
                    </p>
                </div>
                <div class="mt-4 flex flex-wrap gap-3">
                    <a href="/discover" class="btn-primary">
                        Explore all posts
                    </a>
                    <a href="#archive" class="btn-ghost">
                        Browse archive
                    </a>
                </div>
            </section>
        )
    }

    <!-- ── Featured post (first page only) ──────────────────────────────── -->
    {
        featuredPost && (
            <section class="mb-6 animate-fade-up" style="animation-delay:0.12s;">
                <div class="mb-2 flex items-center justify-between gap-4">
                    <p class="m-0 text-xs font-semibold text-(--color-muted)">Featured story</p>
                </div>
                <a
                    href={`/blog/${featuredPost.id}`}
                    class="group flex flex-col lg:flex-row overflow-hidden rounded-xl border border-(--color-border) bg-(--color-surface) shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                    style="min-height:16rem;"
                >
                    {featuredPost.data.image && (
                        <div class="lg:w-2/5 h-56 lg:h-64 overflow-hidden shrink-0">
                            <img
                                src={featuredPost.data.image}
                                alt={featuredPost.data.title}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                loading="eager"
                            />
                        </div>
                    )}
                    <div class="flex flex-col justify-center p-4 lg:p-6 gap-3 grow">
                        <div
                            class="flex flex-wrap items-center gap-2 text-xs font-mono"
                            style="color:var(--color-accent-1);"
                        >
                            <span>{formatBlogDate(featuredPost.data.date)}</span>
                            <span style="color:var(--color-subtle);">•</span>
                            <span>
                                {estimateReadingTime(
                                    featuredPost.body || "",
                                    featuredPost.data.wordCount
                                )}{" "}
                                min read
                            </span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold leading-tight text-balance">
                            {featuredPost.data.shortTitle || featuredPost.data.title}
                        </h2>
                        {featuredPost.body && (
                            <p
                                class="text-base leading-relaxed line-clamp-3"
                                style="color:var(--color-text-soft);"
                            >
                                {createExcerpt(featuredPost.body, 260)}
                            </p>
                        )}
                        <span
                            class="inline-flex items-center gap-2 text-sm font-semibold transition-all duration-200 group-hover:gap-3.5"
                            style="color:var(--color-accent-1);"
                        >
                            Read article <span aria-hidden="true">→</span>
                        </span>
                    </div>
                </a>
            </section>
        )
    }

    <!-- ── Archive grid ──────────────────────────────────────────────────── -->
    <section
        id="archive"
        transition:animate="fade"
        class="animate-fade-up"
        style="animation-delay:0.2s;"
    >
        <div
            class="mb-6 flex items-end justify-between gap-4 border-b border-(--color-border) pb-4 max-[480px]:items-start"
        >
            <div>
                <p class="mb-2 text-xs font-semibold text-(--color-muted)">
                    {isFirstPage ? "Archive index" : "Archive"}
                </p>
                <h2 class="m-0 text-2xl font-semibold leading-tight text-(--color-text)">
                    {isFirstPage ? "More from the archive" : `Page ${page.currentPage}`}
                </h2>
            </div>
            <p class="m-0 whitespace-nowrap font-mono text-xs text-(--color-muted)">
                {gridPosts.length} articles
            </p>
        </div>

        <div
            class="grid gap-4 stagger"
            style="grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));"
        >
            {
                gridPosts.map((post) => (
                    <a
                        href={`/blog/${post.id}`}
                        class="group flex flex-col overflow-hidden rounded-xl border border-(--color-border) bg-(--color-surface) shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                    >
                        {post.data.image && (
                            <div class="h-44 overflow-hidden shrink-0">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    loading="lazy"
                                />
                            </div>
                        )}
                        <div class="flex flex-col grow p-4 gap-3">
                            <div
                                class="flex flex-wrap items-center gap-1.5 text-xs font-mono"
                                style="color:var(--color-accent-1);"
                            >
                                <span>{formatBlogDate(post.data.date)}</span>
                                <span style="color:var(--color-subtle);">·</span>
                                <span>
                                    {estimateReadingTime(post.body || "", post.data.wordCount)} min
                                </span>
                            </div>
                            <h3
                                class="text-base font-bold leading-snug line-clamp-2 text-pretty"
                                style="color:var(--color-text);"
                            >
                                {post.data.shortTitle || post.data.title}
                            </h3>
                            {post.body && (
                                <p
                                    class="text-sm leading-relaxed line-clamp-3 mt-auto"
                                    style="color:var(--color-text-soft);"
                                >
                                    {createExcerpt(post.body, 160)}
                                </p>
                            )}
                            <div
                                class="mt-2 flex items-center gap-1.5 text-xs font-semibold transition-all duration-200 group-hover:gap-2.5"
                                style="color:var(--color-accent-1);"
                            >
                                Read <span aria-hidden="true">→</span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- ── Pagination ─────────────────────────────────────────────────────── -->
    <nav class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
        {
            page.url.prev ? (
                <a href={page.url.prev} class="btn-ghost">
                    ← Previous
                </a>
            ) : (
                <span class="btn-ghost opacity-30 cursor-not-allowed select-none">← Previous</span>
            )
        }

        <div class="flex items-center gap-1" aria-label="Page numbers">
            {
                paginationItems.map((item) =>
                    item === "ellipsis" ? (
                        <span class="px-1 text-(--color-muted)" aria-hidden="true">
                            …
                        </span>
                    ) : item === page.currentPage ? (
                        <span
                            aria-current="page"
                            aria-label={`Page ${item}`}
                            class="inline-flex size-10 items-center justify-center rounded-lg border border-(--color-accent-1) bg-(--color-accent-1) text-sm font-semibold text-(--color-inverse)"
                        >
                            {item}
                        </span>
                    ) : (
                        <a
                            href={item === 1 ? "/" : `/${item}`}
                            aria-label={`Go to page ${item}`}
                            class="inline-flex size-10 items-center justify-center rounded-lg border border-(--color-border) text-sm text-(--color-text-soft) transition-colors hover:border-(--color-accent-1) hover:text-(--color-accent-1)"
                        >
                            {item}
                        </a>
                    )
                )
            }
        </div>

        {
            page.url.next ? (
                <a href={page.url.next} class="btn-primary">
                    Next →
                </a>
            ) : (
                <span class="btn-primary opacity-30 cursor-not-allowed select-none">Next →</span>
            )
        }

        <form
            data-archive-page-form
            data-last-page={page.lastPage}
            class="ml-2 flex items-center gap-2"
        >
            <label for="archive-page-input" class="sr-only">Go to page</label>
            <input
                id="archive-page-input"
                data-archive-page-input
                type="number"
                min="1"
                max={page.lastPage}
                value={page.currentPage}
                required
                class="h-10 w-16 rounded-lg border border-(--color-border) bg-(--color-surface) px-2 text-center text-sm text-(--color-text) outline-none focus:border-(--color-focus) focus:outline-2 focus:outline-(--color-focus)"
            />
            <button type="submit" class="btn-ghost h-10 px-3 text-sm">Go</button>
        </form>
    </nav>

    <script>
        const pageForm = document.querySelector<HTMLFormElement>("[data-archive-page-form]");
        const pageInput = document.querySelector<HTMLInputElement>("[data-archive-page-input]");

        pageForm?.addEventListener("submit", (event) => {
            event.preventDefault();
            const targetPage = Number(pageInput?.value);
            const lastPage = Number(pageForm.dataset.lastPage);

            if (!Number.isInteger(targetPage) || targetPage < 1 || targetPage > lastPage) {
                pageInput?.reportValidity();
                return;
            }

            window.location.assign(targetPage === 1 ? "/" : `/${targetPage}`);
        });
    </script>
</Layout>
