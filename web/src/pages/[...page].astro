---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { createExcerpt, estimateReadingTime, formatBlogDate, sortBlogPosts } from "../lib/blog";

export async function getStaticPaths({ paginate }: any) {
    const allPosts = await getCollection("blog");
    const sortedPosts = sortBlogPosts(allPosts);
    return paginate(sortedPosts, { pageSize: 9 });
}

import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<Layout title="The Architect's Blueprint | Engineering Blog">
    <section class="grid gap-8 xl:grid-cols-[1.1fr_0.9fr] items-start px-4 pt-16 pb-20">
        <div class="space-y-6">
            <h1 class="text-[clamp(3rem,6vw,5rem)] leading-[1.05] font-bold">
                <span class="gradient-text">Architecting</span> the Future.
            </h1>
            <p class="max-w-155 text-xl text-zinc-300">
                Deep dives on big tech infra, scale, and the pulse of modern engineering.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/discover"
                    class="px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-linear-to-br from-indigo-500/20 to-blue-500/20 text-indigo-100 border border-indigo-400/20 hover:border-indigo-300/50 hover:text-white"
                >
                    Try Discover
                </a>
                <a
                    href="#archive"
                    class="px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/30"
                >
                    Browse archive
                </a>
            </div>
        </div>

        <aside class="glass-card p-6 space-y-4">
            <div>
                <p class="text-xs uppercase tracking-[0.32em] text-zinc-500">Browse smarter</p>
                <h2 class="mt-2 text-2xl font-bold">Discover the searchable archive</h2>
            </div>
            <p class="text-sm text-zinc-400">
                The new discover view surfaces topic chips, random spotlights, and fast filtering
                across the full archive.
            </p>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Quick actions</div>
                <ul class="mt-3 space-y-2 text-sm text-zinc-300">
                    <li>• Search by keyword or excerpt</li>
                    <li>• Jump to AI, cloud, biotech, or databases</li>
                    <li>• Open a random post when you want inspiration</li>
                </ul>
            </div>
        </aside>
    </section>

    <section
        id="archive"
        transition:animate="fade"
        class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-8"
    >
        {
            page.data.map((post) => (
                <a
                    href={`/blog/${post.id}`}
                    class="glass-card flex flex-col p-8 min-h-50 overflow-hidden group"
                >
                    {post.data.image && (
                        <div class="-mx-8 -mt-8 mb-6 h-48 overflow-hidden">
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                loading="lazy"
                            />
                        </div>
                    )}
                    <div class="post-content grow flex flex-col">
                        <div class="font-mono text-sm text-indigo-300/80 mb-3 flex flex-wrap items-center gap-2">
                            <span>{formatBlogDate(post.data.date)}</span>
                            <span>•</span>
                            <span>{estimateReadingTime(post.body || "")} min read</span>
                        </div>
                        <h2
                            class="text-lg m-0 leading-tight font-bold mb-3 line-clamp-2"
                            title={post.data.title}
                        >
                            {post.data.shortTitle || post.data.title}
                        </h2>
                        {post.body && (
                            <p class="text-sm text-zinc-400 line-clamp-3 leading-relaxed mt-auto">
                                {createExcerpt(post.body || "", 180)}
                            </p>
                        )}
                    </div>
                </a>
            ))
        }
    </section>

    <div class="mt-16 flex items-center justify-center gap-6">
        {
            page.url.prev ? (
                <a
                    href={page.url.prev}
                    class="px-6 py-2.5 rounded-lg font-sans font-semibold text-sm transition-all duration-300 bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/30 hover:-translate-y-0.5"
                >
                    ← Previous
                </a>
            ) : (
                <span class="px-6 py-2.5 rounded-lg font-sans font-semibold text-sm bg-white/5 text-zinc-600 border border-white/5 cursor-not-allowed">
                    ← Previous
                </span>
            )
        }

        <span class="text-zinc-400 font-mono text-sm">
            Page {page.currentPage} of {page.lastPage}
        </span>

        {
            page.url.next ? (
                <a
                    href={page.url.next}
                    class="px-6 py-2.5 rounded-lg font-sans font-semibold text-sm transition-all duration-300 bg-linear-to-br from-indigo-500/20 to-blue-500/20 text-indigo-200 border border-indigo-500/30 hover:bg-linear-to-br hover:from-indigo-500/40 hover:to-blue-500/40 hover:border-indigo-400/50 hover:text-white hover:-translate-y-0.5 shadow-[0_0_15px_-3px_rgba(99,102,241,0.2)] hover:shadow-[0_4px_20px_-3px_rgba(99,102,241,0.4)]"
                >
                    Next →
                </a>
            ) : (
                <span class="px-6 py-2.5 rounded-lg font-sans font-semibold text-sm bg-white/5 text-zinc-600 border border-white/5 cursor-not-allowed">
                    Next →
                </span>
            )
        }
    </div>
</Layout>
