---
import Layout from "../layouts/Layout.astro";
import { getCloudPosts } from "../lib/cloud-blog";
import {
    createExcerpt,
    createSearchText,
    estimateReadingTime,
    extractTopics,
    formatBlogDate,
    formatCount,
} from "../lib/blog";

export const prerender = false;

const allPosts = await getCloudPosts();
const latestPost = allPosts[0];
const totalWords = allPosts.reduce(
    (sum, post) => sum + (post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0),
    0
);
const avgRead = Math.max(1, Math.round(totalWords / Math.max(1, allPosts.length) / 200));
const topics = extractTopics(allPosts, 8);
---

<Layout title="Discover | The Architect's Blueprint" sidebarPosts={allPosts}>
    <!-- ── Page header ──────────────────────────────────────────────────── -->
    <section class="pt-6 pb-12 sm:pt-10 animate-fade-up">
        <p class="mb-5 flex items-center gap-2 text-sm font-semibold text-(--color-accent-2)">
            <span class="size-2 rounded-full bg-(--color-accent-2)" aria-hidden="true"></span> Discover
            the archive
        </p>
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div class="max-w-2xl">
                <h1 class="discover-title">Find the story behind the systems.</h1>
                <p class="mt-4 text-lg leading-relaxed" style="color:var(--color-text-soft);">
                    Instant search, topic shortcuts, and a rotating spotlight across the full
                    archive of engineering deep dives.
                </p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="/" class="btn-ghost">Browse archive</a>
                    <button type="button" data-discover-random class="btn-primary"
                        >Open a random article</button
                    >
                </div>
            </div>

            <!-- Stats panel -->
            <div
                class="shrink-0 rounded-xl border border-(--color-border) bg-(--color-surface) p-5 shadow-(--shadow-card) lg:w-72 space-y-4"
            >
                <p class="mb-2 text-xs font-semibold text-(--color-muted)">Archive activity</p>
                <div class="grid grid-cols-2 gap-3">
                    <div
                        class="rounded-lg border border-(--color-border) bg-(--color-surface-soft) p-4"
                    >
                        <p class="text-xs" style="color:var(--color-muted);">Articles</p>
                        <p
                            class="mt-1 font-(family-name:--font-display) text-2xl font-bold leading-none text-(--color-accent-1)"
                        >
                            {formatCount(allPosts.length)}
                        </p>
                    </div>
                    <div
                        class="rounded-lg border border-(--color-border) bg-(--color-surface-soft) p-4"
                    >
                        <p class="text-xs" style="color:var(--color-muted);">Avg read</p>
                        <p
                            class="mt-1 font-(family-name:--font-display) text-2xl font-bold leading-none text-(--color-accent-1)"
                        >
                            {avgRead}<span
                                class="ml-1 font-sans text-sm font-normal text-(--color-muted)"
                                >m</span>
                        </p>
                    </div>
                </div>
                {
                    latestPost && (
                        <a
                            href={`/blog/${latestPost.id}`}
                            class="block rounded-xl border border-(--color-border) bg-(--color-surface-soft) p-4 transition-colors hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                        >
                            <p class="mb-2 text-xs font-semibold text-(--color-muted)">
                                Latest article
                            </p>
                            <p class="text-sm font-bold leading-snug line-clamp-2">
                                {latestPost.data.shortTitle || latestPost.data.title}
                            </p>
                            <p class="text-xs mt-1.5" style="color:var(--color-muted);">
                                {formatBlogDate(latestPost.data.date)}
                            </p>
                        </a>
                    )
                }
            </div>
        </div>
    </section>

    <!-- ── Search & filter ──────────────────────────────────────────────── -->
    <section
        class="rounded-xl border border-(--color-border) bg-(--color-surface) p-5 shadow-(--shadow-card) sm:p-7 animate-fade-up"
        style="animation-delay:0.12s;"
    >
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="grow">
                <p class="mb-2 text-xs font-semibold text-(--color-muted)">Search the archive</p>
                <h2 class="m-0 text-xl font-semibold">Find by topic, title, or excerpt</h2>
            </div>
            <label class="relative w-full sm:max-w-sm">
                <span class="sr-only">Search posts</span>
                <svg
                    class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none"
                    style="color:var(--color-muted);"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
                </svg>
                <input
                    type="search"
                    data-discover-search
                    placeholder="AI, cloud, databases, biotech…"
                    class="w-full rounded-xl border border-(--color-border-strong) bg-(--input-bg) py-3 pl-10 pr-4 text-sm text-(--color-text) outline-none transition-all duration-200 focus:border-(--color-focus) focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-(--color-focus)"
                />
            </label>
        </div>

        <!-- Topic chips -->
        {
            topics.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                    {topics.map((topic) => (
                        <button
                            type="button"
                            data-topic-chip
                            data-topic-query={topic.query}
                            aria-pressed="false"
                            class="inline-flex items-center whitespace-nowrap rounded-md border border-(--color-accent-medium) bg-(--color-accent-soft) px-3 py-1 text-xs font-semibold text-(--color-accent-1) transition-colors hover:border-(--color-accent-1) hover:bg-(--color-accent-medium) aria-pressed:border-(--color-accent-1) aria-pressed:bg-(--color-accent-medium)"
                        >
                            {topic.label}
                            <span class="ml-1.5 opacity-50">({topic.count})</span>
                        </button>
                    ))}
                    <button
                        type="button"
                        data-clear-search
                        hidden
                        class="inline-flex items-center whitespace-nowrap rounded-md border border-(--color-accent-medium) bg-(--color-accent-soft) px-3 py-1 text-xs font-semibold text-(--color-accent-1) transition-colors hover:border-(--color-accent-1) hover:bg-(--color-accent-medium)"
                    >
                        Clear ✕
                    </button>
                </div>
            )
        }
    </section>

    <!-- ── Results ──────────────────────────────────────────────────────── -->
    <section class="mt-10 animate-fade-up" style="animation-delay:0.2s;">
        <div class="mb-6 flex items-center justify-between gap-4">
            <div>
                <p class="mb-2 text-xs font-semibold text-(--color-muted)">Search results</p>
                <h2 class="text-lg font-bold">
                    <span data-discover-count>{formatCount(allPosts.length)}</span> results
                </h2>
            </div>
        </div>

        <div
            class="grid gap-4 stagger"
            style="grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));"
        >
            {
                allPosts.map((post, index) => (
                    <a
                        href={`/blog/${post.id}`}
                        data-discover-card
                        data-search={createSearchText(post)}
                        hidden={index >= 9}
                        class="group flex flex-col overflow-hidden rounded-xl border border-(--color-border) bg-(--color-surface) shadow-(--shadow-card) transition-colors duration-150 hover:border-(--color-border-hover) hover:bg-(--color-surface-hover)"
                    >
                        {post.data.image && (
                            <div class="h-40 overflow-hidden shrink-0">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    loading="lazy"
                                />
                            </div>
                        )}
                        <div class="flex flex-col grow p-4 gap-3">
                            <div
                                class="flex items-center gap-2 text-xs font-mono"
                                style="color:var(--color-accent-1);"
                            >
                                <span>{formatBlogDate(post.data.date)}</span>
                                <span style="color:var(--color-subtle);">·</span>
                                <span>
                                    {estimateReadingTime(post.body || "", post.data.wordCount)} min
                                </span>
                            </div>
                            <h3 class="text-sm font-bold leading-snug line-clamp-2 text-pretty transition-colors group-hover:text-(--color-accent-1) hover:text-(--color-accent-1)">
                                {post.data.shortTitle || post.data.title}
                            </h3>
                            <p
                                class="text-xs leading-relaxed line-clamp-3 mt-auto"
                                style="color:var(--color-text-soft);"
                            >
                                {createExcerpt(post.body || "", 150)}
                            </p>
                            <div
                                class="mt-2 flex items-center gap-1.5 text-xs font-semibold transition-all duration-200 group-hover:gap-2.5"
                                style="color:var(--color-accent-1);"
                            >
                                Read <span aria-hidden="true">→</span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <!-- Empty state -->
        <div
            hidden
            data-discover-empty
            class="mt-12 rounded-2xl p-10 text-center"
            style="border:1px dashed var(--color-border-strong);background:var(--color-surface-soft);"
        >
            <p
                class="mb-2 font-(family-name:--font-display) text-2xl font-semibold text-(--color-text)"
            >
                No matching articles
            </p>
            <p class="text-sm" style="color:var(--color-text-soft);">
                Try a broader search or choose another topic.
            </p>
        </div>

        <nav
            hidden
            data-discover-pagination
            aria-label="Search result pages"
            class="mt-6 flex flex-wrap items-center justify-center gap-2"
        >
            <button
                type="button"
                data-page-previous
                disabled
                class="btn-ghost disabled:cursor-not-allowed disabled:opacity-40">Previous</button
            >
            <div data-page-numbers class="flex items-center gap-1" aria-label="Page numbers"></div>
            <button
                type="button"
                data-page-next
                class="btn-ghost disabled:cursor-not-allowed disabled:opacity-40">Next</button
            >
            <form data-page-form class="ml-2 flex items-center gap-2">
                <label for="discover-page-input" class="sr-only">Go to page</label>
                <input
                    id="discover-page-input"
                    data-page-input
                    type="number"
                    min="1"
                    value="1"
                    required
                    class="h-10 w-16 rounded-lg border border-(--color-border) bg-(--color-surface) px-2 text-center text-sm text-(--color-text) outline-none focus:border-(--color-focus) focus:outline-2 focus:outline-(--color-focus)"
                />
                <button type="submit" class="btn-ghost h-10 px-3 text-sm">Go</button>
            </form>
        </nav>
    </section>

    <script>
        const cards = Array.from(
            document.querySelectorAll("[data-discover-card]")
        ) as HTMLAnchorElement[];
        const searchInput = document.querySelector(
            "[data-discover-search]"
        ) as HTMLInputElement | null;
        const topicButtons = Array.from(
            document.querySelectorAll("[data-topic-chip]")
        ) as HTMLButtonElement[];
        const randomButton = document.querySelector("[data-discover-random]");
        const emptyState = document.querySelector("[data-discover-empty]") as HTMLElement | null;
        const resultCount = document.querySelector("[data-discover-count]") as HTMLElement | null;
        const clearBtn = document.querySelector("[data-clear-search]") as HTMLElement | null;
        const pagination = document.querySelector(
            "[data-discover-pagination]"
        ) as HTMLElement | null;
        const previousButton = document.querySelector(
            "[data-page-previous]"
        ) as HTMLButtonElement | null;
        const nextButton = document.querySelector("[data-page-next]") as HTMLButtonElement | null;
        const pageNumbers = document.querySelector("[data-page-numbers]") as HTMLElement | null;
        const pageForm = document.querySelector("[data-page-form]") as HTMLFormElement | null;
        const pageInput = document.querySelector("[data-page-input]") as HTMLInputElement | null;
        const pageSize = 9;

        let activeChip: HTMLButtonElement | null = null;
        let currentPage = 1;
        let filteredCards = cards;
        let searchTimer = 0;

        const getPaginationItems = (totalPages: number): Array<number | "ellipsis"> => {
            const nearbyPages = [
                ...new Set([1, currentPage - 1, currentPage, currentPage + 1, totalPages]),
            ]
                .filter((pageNumber) => pageNumber >= 1 && pageNumber <= totalPages)
                .sort((left, right) => left - right);
            const items: Array<number | "ellipsis"> = [];

            nearbyPages.forEach((pageNumber, index) => {
                if (index > 0 && pageNumber - nearbyPages[index - 1] > 1) {items.push("ellipsis");}
                items.push(pageNumber);
            });

            return items;
        };

        const renderPage = () => {
            const totalPages = Math.max(1, Math.ceil(filteredCards.length / pageSize));
            currentPage = Math.min(currentPage, totalPages);
            const firstIndex = (currentPage - 1) * pageSize;
            const visibleCards = new Set(filteredCards.slice(firstIndex, firstIndex + pageSize));

            cards.forEach((card) => {
                card.hidden = !visibleCards.has(card);
            });

            if (resultCount)
            {resultCount.textContent = new Intl.NumberFormat("en").format(filteredCards.length);}
            if (emptyState) {emptyState.hidden = filteredCards.length > 0;}
            if (pagination) {pagination.hidden = totalPages <= 1;}
            if (previousButton) {previousButton.disabled = currentPage <= 1;}
            if (nextButton) {nextButton.disabled = currentPage >= totalPages;}
            if (pageInput) {
                pageInput.max = totalPages.toString();
                pageInput.value = currentPage.toString();
            }
            if (pageNumbers) {
                pageNumbers.replaceChildren();
                getPaginationItems(totalPages).forEach((item) => {
                    if (item === "ellipsis") {
                        const ellipsis = document.createElement("span");
                        ellipsis.className = "px-1 text-(--color-muted)";
                        ellipsis.textContent = "…";
                        ellipsis.setAttribute("aria-hidden", "true");
                        pageNumbers.append(ellipsis);
                        return;
                    }

                    if (item === currentPage) {
                        const current = document.createElement("span");
                        current.className =
                            "inline-flex size-10 items-center justify-center rounded-lg border border-(--color-accent-1) bg-(--color-accent-1) text-sm font-semibold text-(--color-inverse)";
                        current.textContent = item.toString();
                        current.setAttribute("aria-current", "page");
                        pageNumbers.append(current);
                        return;
                    }

                    const pageButton = document.createElement("button");
                    pageButton.type = "button";
                    pageButton.className =
                        "inline-flex size-10 items-center justify-center rounded-lg border border-(--color-border) text-sm text-(--color-text-soft) transition-colors hover:border-(--color-accent-1) hover:text-(--color-accent-1)";
                    pageButton.textContent = item.toString();
                    pageButton.setAttribute("aria-label", `Go to page ${item}`);
                    pageButton.addEventListener("click", () => {
                        currentPage = item;
                        renderPage();
                    });
                    pageNumbers.append(pageButton);
                });
            }
        };

        const applyFilters = (resetPage = false) => {
            const query = searchInput?.value.trim().toLowerCase() ?? "";
            const terms = query.split(/\s+/).filter(Boolean);
            filteredCards = cards.filter((card) => {
                const searchText = card.dataset.search ?? "";
                return terms.length === 0 || terms.every((term) => searchText.includes(term));
            });

            if (resetPage) {currentPage = 1;}
            if (clearBtn) {clearBtn.hidden = !query;}
            renderPage();
        };

        const initialQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
        if (searchInput && initialQuery) {
            searchInput.value = initialQuery;
        }
        applyFilters(true);

        searchInput?.addEventListener("input", () => {
            // deselect chip if user types manually
            if (activeChip) {
                activeChip.removeAttribute("data-active");
                activeChip.setAttribute("aria-pressed", "false");
                activeChip = null;
            }
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(() => applyFilters(true), 250);
        });

        topicButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const query = button.dataset.topicQuery ?? "";
                const isSame = activeChip === button;

                // Deselect previous
                if (activeChip) {
                    activeChip.removeAttribute("data-active");
                    activeChip.setAttribute("aria-pressed", "false");
                }

                if (isSame) {
                    // Toggle off
                    activeChip = null;
                    if (searchInput) {searchInput.value = "";}
                } else {
                    activeChip = button;
                    button.setAttribute("data-active", "true");
                    button.setAttribute("aria-pressed", "true");
                    if (searchInput) {searchInput.value = query;}
                }

                window.clearTimeout(searchTimer);
                applyFilters(true);
            });
        });

        clearBtn?.addEventListener("click", () => {
            if (searchInput) {searchInput.value = "";}
            window.clearTimeout(searchTimer);
            if (activeChip) {
                activeChip.removeAttribute("data-active");
                activeChip.setAttribute("aria-pressed", "false");
                activeChip = null;
            }
            applyFilters(true);
            searchInput?.focus();
        });

        previousButton?.addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderPage();
            }
        });

        nextButton?.addEventListener("click", () => {
            const totalPages = Math.ceil(filteredCards.length / pageSize);
            if (currentPage < totalPages) {
                currentPage++;
                renderPage();
            }
        });

        pageForm?.addEventListener("submit", (event) => {
            event.preventDefault();
            const targetPage = Number(pageInput?.value);
            const totalPages = Math.max(1, Math.ceil(filteredCards.length / pageSize));

            if (!Number.isInteger(targetPage) || targetPage < 1 || targetPage > totalPages) {
                pageInput?.reportValidity();
                return;
            }

            currentPage = targetPage;
            renderPage();
        });

        randomButton?.addEventListener("click", () => {
            const pool = filteredCards;
            const target = (pool.length > 0 ? pool : cards)[
                Math.floor(Math.random() * (pool.length || cards.length))
            ];
            const href = target?.getAttribute("href");
            if (href) {window.location.assign(href);}
        });
    </script>
</Layout>
