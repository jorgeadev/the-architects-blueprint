---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import {
    createExcerpt,
    createSearchText,
    estimateReadingTime,
    extractTopics,
    formatBlogDate,
    formatCount,
    sortBlogPosts,
} from "../lib/blog";

const allPosts = sortBlogPosts(await getCollection("blog"));
const latestPost = allPosts[0];
const totalWords = allPosts.reduce((sum, post) => sum + post.body.trim().split(/\s+/).filter(Boolean).length, 0);
const topics = extractTopics(allPosts, 6);
---

<Layout title="Discover | The Architect's Blueprint">
    <section class="grid gap-8 xl:grid-cols-[1.15fr_0.85fr] items-start">
        <div class="space-y-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-indigo-400/20 bg-indigo-400/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-indigo-200">
                Live discovery
            </div>
            <h1 class="text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95] font-bold">
                Find the story behind the <span class="gradient-text">systems</span>.
            </h1>
            <p class="max-w-2xl text-lg text-zinc-300/90">
                Browse the full archive with instant search, topic shortcuts, and a rotating spotlight so
                the most interesting architecture notes surface fast.
            </p>

            <div class="flex flex-wrap gap-3">
                <a
                    href="/"
                    class="px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/30"
                >
                    View archive
                </a>
                <button
                    type="button"
                    data-discover-random
                    class="px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-linear-to-br from-indigo-500/25 to-blue-500/25 text-indigo-100 border border-indigo-400/30 hover:border-indigo-300/60 hover:text-white"
                >
                    Random spotlight
                </button>
            </div>
        </div>

        <aside class="glass-card p-6 space-y-5">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.32em] text-zinc-500">Archive pulse</p>
                    <h2 class="mt-2 text-2xl font-bold">What’s in the feed</h2>
                </div>
                <div class="rounded-full bg-indigo-400/10 px-4 py-2 text-sm font-semibold text-indigo-200">
                    {formatCount(allPosts.length)} posts
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Latest drop</div>
                    <div class="mt-2 text-sm font-semibold text-white">{latestPost ? formatBlogDate(latestPost.data.date) : "—"}</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-xs uppercase tracking-[0.24em] text-zinc-500">Read time</div>
                    <div class="mt-2 text-sm font-semibold text-white">
                        {Math.max(1, Math.round(totalWords / 200))} min total
                    </div>
                </div>
            </div>

            {latestPost && (
                <a
                    href={`/blog/${latestPost.id}`}
                    class="block rounded-2xl border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-indigo-400/30 hover:bg-white/10"
                >
                    <div class="text-xs uppercase tracking-[0.24em] text-indigo-300/70">Latest article</div>
                    <h3 class="mt-2 text-lg font-semibold leading-snug">{latestPost.data.shortTitle || latestPost.data.title}</h3>
                    <p class="mt-3 text-sm text-zinc-400 line-clamp-3">
                        {createExcerpt(latestPost.body, 150)}
                    </p>
                </a>
            )}
        </aside>
    </section>

    <section class="mt-12 glass-card p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs uppercase tracking-[0.32em] text-zinc-500">Search the archive</p>
                <h2 class="mt-2 text-2xl font-bold">Filter by topic, title, or excerpt</h2>
            </div>
            <label class="w-full lg:max-w-md">
                <span class="sr-only">Search posts</span>
                <input
                    type="search"
                    data-discover-search
                    placeholder="Search AI, cloud, databases, biotech..."
                    class="w-full rounded-xl border border-white/10 bg-[#070518] px-4 py-3 text-sm text-white placeholder:text-zinc-500 outline-none transition-colors focus:border-indigo-400/50"
                />
            </label>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            {topics.map((topic) => (
                <button
                    type="button"
                    data-topic-chip
                    data-topic-query={topic.query}
                    class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-zinc-200 transition-all duration-300 hover:border-indigo-400/40 hover:bg-white/10"
                >
                    {topic.label} <span class="text-zinc-500">({topic.count})</span>
                </button>
            ))}
        </div>
    </section>

    <section class="mt-10">
        <div class="mb-5 flex items-center justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-[0.32em] text-zinc-500">All posts</p>
                <h2 class="mt-2 text-2xl font-bold">Currently surfaced from the archive</h2>
            </div>
            <p class="text-sm text-zinc-500">{formatCount(allPosts.length)} results</p>
        </div>

        <div class="grid gap-6 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
            {allPosts.map((post) => (
                <a
                    href={`/blog/${post.id}`}
                    data-discover-card
                    data-search={createSearchText(post)}
                    class="glass-card flex flex-col overflow-hidden p-6 group"
                >
                    {post.data.image && (
                        <div class="-mx-6 -mt-6 mb-5 h-44 overflow-hidden">
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                loading="lazy"
                            />
                        </div>
                    )}
                    <div class="flex items-center gap-2 text-xs font-mono text-indigo-300/80">
                        <span>{formatBlogDate(post.data.date)}</span>
                        <span>•</span>
                        <span>{estimateReadingTime(post.body)} min read</span>
                    </div>
                    <h3 class="mt-3 text-lg font-bold leading-tight text-white line-clamp-2">
                        {post.data.shortTitle || post.data.title}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-zinc-400 line-clamp-4">
                        {createExcerpt(post.body, 180)}
                    </p>
                    <div class="mt-6 flex items-center justify-between text-sm font-semibold text-indigo-200 transition-colors group-hover:text-white">
                        <span>Open article</span>
                        <span>→</span>
                    </div>
                </a>
            ))}
        </div>

        <div data-discover-empty class="mt-10 hidden rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center text-zinc-400">
            No posts match that search yet. Try a broader topic chip.
        </div>
    </section>

    <script>
        const cards = Array.from(document.querySelectorAll("[data-discover-card]"));
        const searchInput = document.querySelector("[data-discover-search]");
        const topicButtons = Array.from(document.querySelectorAll("[data-topic-chip]"));
        const randomButton = document.querySelector("[data-discover-random]");
        const emptyState = document.querySelector("[data-discover-empty]");

        const applyFilters = () => {
            const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
            let visibleCount = 0;

            cards.forEach((card) => {
                const searchText = card.dataset.search ?? "";
                const matches = !query || searchText.includes(query);
                card.hidden = !matches;

                if (matches) {
                    visibleCount += 1;
                }
            });

            if (emptyState) {
                emptyState.hidden = visibleCount > 0;
            }
        };

        searchInput?.addEventListener("input", applyFilters);

        topicButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const query = button.getAttribute("data-topic-query") ?? "";

                if (searchInput instanceof HTMLInputElement) {
                    searchInput.value = query;
                    searchInput.focus();
                }

                applyFilters();
            });
        });

        randomButton?.addEventListener("click", () => {
            const visibleCards = cards.filter((card) => !card.hidden);
            const pool = visibleCards.length > 0 ? visibleCards : cards;
            const randomCard = pool[Math.floor(Math.random() * pool.length)];
            const href = randomCard?.getAttribute("href");

            if (href) {
                window.location.assign(href);
            }
        });
    </script>
</Layout>
